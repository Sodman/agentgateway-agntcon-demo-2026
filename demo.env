# Source this in EVERY terminal you use for the demo, from this folder (bash or zsh):
#     source demo.env
# It keeps the whole demo inside $DEMO_HOME, and makes the standard install one-liner run
# with no sudo prompt and a pinned release. It only affects the current terminal.
# (Other tools that read XDG_CONFIG_HOME, like gh, will look in the demo folder in this terminal.)

# Provider keys live in .env.local (gitignored). The scripts do not print them.
[ -f ./.env.local ] && . ./.env.local

export DEMO_HOME="${DEMO_HOME:-$HOME/.agw-demo}"

# Read by the installer:  curl -sL https://agentgateway.dev/install | bash
export AGENTGATEWAY_INSTALL_DIR="$DEMO_HOME/bin"     # instead of /usr/local/bin
export USE_SUDO=false                                 # so no password prompt
export DESIRED_VERSION="${DESIRED_VERSION:-v1.6.0}"   # pinned; also skips a rate-limited GitHub API call
mkdir -p "$AGENTGATEWAY_INSTALL_DIR"
export PATH="$AGENTGATEWAY_INSTALL_DIR:$PATH"

# Read by agentgateway: started with no arguments, it writes config.yaml and data.db here
export XDG_CONFIG_HOME="$DEMO_HOME/config"

export AGW_URL="${AGW_URL:-http://localhost:4000}"

# Models the demo uses. Each must exist at its provider and in the v1.6.0 built-in
# price catalog. claude-haiku-5-5 is priced only in newer catalogs, and v1.6.0
# cannot import those (Refresh base costs returns 500), so Bob uses haiku-4-5.
export CLAUDE_MODEL="${CLAUDE_MODEL:-claude-sonnet-5}"
export CLAUDE_SMALL_MODEL="${CLAUDE_SMALL_MODEL:-claude-haiku-4-5}"
export OPENAI_MODEL="${OPENAI_MODEL:-gpt-5-mini}"
export OPENAI_BIG_MODEL="${OPENAI_BIG_MODEL:-gpt-5}"

# Trying the demo with no API keys or no network: run `export DEMO_MOCK=1` before sourcing this,
# and start `python3 scripts/mock-llm.py` in another terminal.
# This replaces any keys .env.local just loaded, so the mock run does not call the real providers.
if [ "${DEMO_MOCK:-}" = "1" ]; then
  export ANTHROPIC_API_KEY=mock
  export OPENAI_API_KEY=mock
fi

echo "agentgateway demo shell ready (folder: $DEMO_HOME${DEMO_MOCK:+, mock providers})"
echo "When agentgateway starts it prints the UI. With the defaults, that is ${AGW_URL}/ui"
